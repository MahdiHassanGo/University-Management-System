model Student {
  id                  String         @id @default(uuid())
  studentId           String         @unique
  userId              String         @unique
  user                User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  name                String
  gender              Gender?
  contactNo           String?
  emergencyContactNo  String?
  address             String?
  bloodGroup          String?
  programId           String
  program             Program        @relation(fields: [programId], references: [id], onDelete: Restrict)
  admissionSemesterId String
  admissionSemester   AcademicSemester @relation(fields: [admissionSemesterId], references: [id], onDelete: Restrict)
  academicStatus      AcademicStatus @default(ACTIVE)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  enrollments       Enrollment[]
  attendanceRecords AttendanceRecord[]
  examResults       ExamResult[]
  invoices          FeeInvoice[]

  @@index([programId])
  @@index([admissionSemesterId])
  @@index([academicStatus])
  @@map("students")
}

model Instructor {
  id             String         @id @default(uuid())
  employeeId     String         @unique
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  name           String
  designation    String
  departmentId   String
  department     Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  contactNo      String?
  academicStatus AcademicStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  sections Section[]

  @@index([departmentId])
  @@index([academicStatus])
  @@map("instructors")
}
