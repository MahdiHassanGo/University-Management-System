            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"CSE\",\n  \"name\": \"Computer Science and Engineering\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/departments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "departments"]
