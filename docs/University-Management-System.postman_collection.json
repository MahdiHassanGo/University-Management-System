            "body": {
              "mode": "raw",
              "raw": "{\n  \"sectionId\": \"{{sectionId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/enrollments",
              "host": ["{{baseUrl}}"],
